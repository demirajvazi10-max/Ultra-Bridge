# Copy to .env.local and fill in. Never commit .env.local.

# Sanity Context MCP endpoint that serves the structured dataset (GROQ mode).
# Format: https://api.sanity.io/v1/context/organizations/<ORG_ID>/mcp/<ENDPOINT_NAME>
SANITY_CONTEXT_MCP_URL=

# Optional second endpoint that serves the Knowledge Base (guides and explanations).
# If empty, the agent runs with the structured dataset only.
SANITY_CONTEXT_KB_MCP_URL=

# Organization API token with the Context Viewer role. Keep it server side.
SANITY_ORGANIZATION_TOKEN=

# Language models. Set one key or several. Every provider with a key joins a fallback chain:
# if one model is rate limited or down, the next one answers. Free tiers have separate quotas
# per model, so the chain uses several models per provider.
# Default provider order: anthropic, google, groq, cerebras (override with ULTRA_MODEL_ORDER).
GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# ANTHROPIC_API_KEY=

# Optional model lists (comma separated, tried in order) and tuning.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# CEREBRAS_MODEL=gpt-oss-120b
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ULTRA_MODEL_ORDER=google,groq,cerebras
# MODEL_TIMEOUT_SECONDS=25
# MAX_TOOL_RESULT_CHARS=6000

# Set to "offline" to run without any language model (scripted demo answers only).
# ULTRA_MODEL=offline

# Public demo protection: requests per minute per visitor (default 8).
# RATE_LIMIT_PER_MINUTE=8
