# Try Ultra Bridge locally with NO accounts and NO API keys.
#
# Terminal 1:  npm run mock
# Terminal 2:  copy this file to .env.local, then  npm run dev
#
# The mock server answers real GROQ queries over the seed data. The offline model is a small scripted
# stand-in that only understands the example questions on the page.
SANITY_CONTEXT_MCP_URL=http://127.0.0.1:4010/v1/context/organizations/mock/mcp/ultra-bridge
SANITY_CONTEXT_KB_MCP_URL=http://127.0.0.1:4010/v1/context/organizations/mock/mcp/ultra-bridge?mode=knowledge_base&knowledgeBases=kb-mock
SANITY_ORGANIZATION_TOKEN=mock-token
ULTRA_MODEL=offline
